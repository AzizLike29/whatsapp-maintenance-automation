# Comma-separated WhatsApp group IDs to process, e.g. 120363000000000000@g.us
# Leave empty on first run and copy the groupId from the logs.
ALLOWED_GROUP_IDS=

# The ID in the spreadsheet URL: https://docs.google.com/spreadsheets/d/<RED_TAG_SPREADSHEET_ID>/edit
# Must be a Google Sheets file; files still in .xlsx format cannot be written through the API.
RED_TAG_SPREADSHEET_ID=

# Tab name of the Red Tag sheet.
RED_TAG_SHEET_NAME=Red Tag

# Optional. Bot phone number, digits only with country code (e.g. 6281234567890).
# When set, a pairing code is shown instead of a QR code for linking WhatsApp.
WHATSAPP_PHONE_NUMBER=

# Path to the Google service account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# Gemini AI for free questions, leave GEMINI_API_KEY empty to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest